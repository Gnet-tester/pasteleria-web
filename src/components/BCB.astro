---
import { useTranslations, getLocalizedPath, defaultLocale, type Locale } from '../i18n/utils';

interface Props {
	lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
---

<section id="bcb" class="bg-sage-800 py-16 text-cream-100 md:py-24">
	<div data-reveal class="mx-auto max-w-2xl px-4 text-center md:px-6">
		<span
			class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-cream-100"
		>
			{t('bcbTeaser.eyebrow')}
		</span>
		<h2 class="mt-4 font-display text-3xl md:text-4xl">{t('bcbTeaser.title')}</h2>
		<p class="mt-4 text-sage-200">{t('bcbTeaser.text')}</p>
		<a
			href={getLocalizedPath('/bcb', lang)}
			class="ripple mt-6 inline-block rounded-full bg-terracotta-400 px-8 py-3 font-medium text-white transition-colors hover:bg-terracotta-500"
		>
			{t('bcbTeaser.cta')}
		</a>
	</div>
</section>
