---
import { Image } from 'astro:assets';
import verrines from '../assets/Imágenes de ejemplo/foto 348.jpg';
import cajaRegalo from '../assets/Imágenes de ejemplo/Caja de pastas.jpg';
import placeholder5 from '../assets/placeholders/placeholder-5.jpg';
import { useTranslations, defaultLocale, type Locale } from '../i18n/utils';

interface Props {
	lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

const items = [
	{
		image: verrines,
		alt: t('especialidades.item1.alt'),
		title: t('especialidades.item1.title'),
		description: t('especialidades.item1.desc')
	},
	{
		image: cajaRegalo,
		alt: t('especialidades.item2.alt'),
		title: t('especialidades.item2.title'),
		description: t('especialidades.item2.desc')
	},
	{
		image: placeholder5,
		alt: t('especialidades.item3.alt'),
		title: t('especialidades.item3.title'),
		description: t('especialidades.item3.desc')
	}
];
---

<section id="especialidades" class="relative bg-cream-50 py-16 md:py-24">
	<div class="mx-auto max-w-6xl px-4 md:px-6">
		<div data-reveal class="mx-auto max-w-2xl text-center">
			<span class="text-sm font-medium uppercase tracking-widest text-terracotta-500">
				{t('especialidades.eyebrow')}
			</span>
			<h2 class="mt-2 font-display text-3xl text-sage-900 md:text-4xl">{t('especialidades.title')}</h2>
		</div>

		<div class="mt-12 grid gap-6 md:grid-cols-3">
			{
				items.map((item) => (
					<div data-reveal class="overflow-hidden rounded-2xl border border-sage-100 bg-white">
						<Image
							src={item.image}
							alt={item.alt}
							width={900}
							widths={[400, 700, 900]}
							sizes="(min-width: 768px) 33vw, 100vw"
							quality={65}
							class="h-56 w-full object-cover"
						/>
						<div class="p-6">
							<h3 class="font-display text-xl text-sage-900">{item.title}</h3>
							<p class="mt-2 text-sm text-sage-700">{item.description}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
