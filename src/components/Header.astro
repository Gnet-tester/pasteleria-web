---
import { Image } from 'astro:assets';
import logo from '../assets/Logotipo.svg';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, getLocalizedPath, getPathWithoutLocale, defaultLocale, type Locale } from '../i18n/utils';

interface Props {
	lang?: Locale;
	logoIntro?: boolean;
}

const { lang = defaultLocale, logoIntro = false } = Astro.props;
const t = useTranslations(lang);
const canonicalPath = getPathWithoutLocale(Astro.url.pathname);

const navLinks = [{ href: getLocalizedPath('/bcb', lang), label: t('nav.bcb') }];
const homeHref = getLocalizedPath('/', lang);
const cartaHref = getLocalizedPath('/carta', lang);
---

<header class="sticky top-0 z-50 bg-cream-50 border-b border-sage-100">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 md:px-6">
		<a href={homeHref} class="flex items-center gap-2">
			<Image
				src={logo}
				alt="Gisela Pastelería Natural"
				data-header-logo
				width={220}
				height={98}
				class={`h-10 w-auto md:h-12 header-logo-img ${logoIntro ? 'header-logo-img--pending' : ''}`}
			/>
		</a>

		<nav class="hidden md:block">
			<ul class="flex items-center gap-8 font-medium text-sage-700">
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href} class="transition-colors hover:text-sage-500">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="hidden items-center gap-3 md:flex">
			<LanguageSwitcher lang={lang} path={canonicalPath} />
			<a
				href={cartaHref}
				class="ripple rounded-full bg-sage-400 px-5 py-2 font-medium text-white transition-colors hover:bg-sage-500"
			>
				{t('nav.carta')}
			</a>
		</div>

		<input type="checkbox" id="menu-toggle" class="peer hidden" />
		<label
			for="menu-toggle"
			aria-label={t('aria.openMenu')}
			class="grid h-10 w-10 cursor-pointer place-items-center rounded-full text-sage-700 hover:bg-sage-100 md:hidden"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
				<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		</label>

		<nav
			class="absolute inset-x-0 top-full hidden border-b border-sage-100 bg-cream-50 peer-checked:block md:hidden"
		>
			<ul class="flex flex-col gap-1 px-4 py-4 font-medium text-sage-700">
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href} class="block rounded-lg px-3 py-2 hover:bg-sage-100">
								{link.label}
							</a>
						</li>
					))
				}
				<li class="px-3 py-2">
					<LanguageSwitcher lang={lang} path={canonicalPath} />
				</li>
				<li>
					<a href={cartaHref} class="ripple mt-2 block rounded-full bg-sage-400 px-3 py-2 text-center text-white hover:bg-sage-500">
						{t('nav.carta')}
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>

<script>
	const headerLogo = document.querySelector<HTMLElement>('[data-header-logo]');
	if (headerLogo) {
		const reveal = () => headerLogo.classList.add('header-logo-img--landed');
		window.addEventListener('hero-logo:landed', reveal, { once: true });
		window.setTimeout(reveal, 8000);
	}
</script>

<style>
	@media (prefers-reduced-motion: no-preference) {
		.header-logo-img--pending {
			opacity: 0;
		}
		.header-logo-img--pending.header-logo-img--landed {
			opacity: 1;
			transition: opacity 0.2s ease;
		}
	}
</style>
