---
import { Image } from 'astro:assets';
import logo from '../assets/Logotipo.svg';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, getLocalizedPath, getPathWithoutLocale, defaultLocale, type Locale } from '../i18n/utils';

interface Props {
	lang?: Locale;
	logoIntro?: boolean;
}

const { lang = defaultLocale, logoIntro = false } = Astro.props;
const t = useTranslations(lang);
const canonicalPath = getPathWithoutLocale(Astro.url.pathname);

// El blog existe en /blog (solo en español) pero de momento no se enlaza desde el menú.
const navLinks = [{ href: getLocalizedPath('/encarga-tu-tarta', lang), label: t('nav.encargaTuTarta') }];
const homeHref = getLocalizedPath('/', lang);
const cartaHref = getLocalizedPath('/carta', lang);
const isCarta = canonicalPath === '/carta';
---

<header
	class:list={[
		'header sticky top-0 z-50',
		isCarta ? 'border-b border-sage-100 bg-cream-50' : 'border-b border-transparent bg-transparent'
	]}
>
	<div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 md:px-6">
		<a href={homeHref} class="flex items-center gap-2">
			{
				logoIntro ? (
					<svg
						viewBox="0 0 3699.21 1651.03"
						class="header-logo-anim h-10 w-auto md:h-12"
						aria-label="Gisela Pastelería Natural"
						role="img"
					>
						<g class="hla-icon-group">
							<path
								pathLength="1"
								class="hla-icon-path"
								style="animation-delay: 0s"
								d="M119.41,1029.07c-5.5,25.46-2.01,50.63,21.38,65.59,36.21,23.16,124.17,17.45,167.39,16.32,110.78-2.9,287.5-24.33,380.27,44.3,135.92,100.55,118.16,342.98-24.74,429.81-97.84,59.45-271.98,72.29-384.52,63.41-87.98-6.94-255.29-37.33-276.71-140.28-19.73-94.86,82.11-166.97,168.96-127.76,58.57,26.44,76.39,101.43,50.03,156.68-8.35,17.49-26.96,27.35-27.73,47.41,16.57,5.54,33.38,10.57,50.46,14.48,126.1,28.93,304.11,22.2,409.35-60.18,80.59-63.09,93.73-172.15-21.57-203.17-72.2-19.43-161.91-14.4-236.65-12.9-105.06,2.11-287.91,20.95-360.88-70.76-65.44-82.26-37.03-225.35,84.97-222.94Z"
							></path>
							<path
								pathLength="1"
								class="hla-icon-path"
								style="animation-delay: 0.15s"
								d="M390.62,252.07C174.89,252.07,0,425.08,0,638.5s174.89,386.43,390.62,386.43,390.62-173.01,390.62-386.43-174.89-386.43-390.62-386.43ZM390.62,868.88c-124.18,0-224.84-99.59-224.84-222.43s100.67-222.43,224.84-222.43,224.84,99.59,224.84,222.43-100.67,222.43-224.84,222.43Z"
							></path>
						</g>

						<g class="hla-rest-group">
							<g class="hla-isela-fill">
								<path pathLength="1" class="hla-isela-path" style="animation-delay: 1.8s" d="M1166.65,956.42c-12.53-6.5-22.53-14.62-30.04-24.35-7.51-9.73-13.01-23.35-16.51-40.85V297.71c0-17.98-2.51-30.09-7.51-36.33-5-6.24-13.51-9.38-25.52-9.38-4.52,0-8.77.76-12.76,2.25-80.58,25.48-161.17,38.23-241.74,38.23-19.52,0-29.27,8.99-29.27,26.97,0,12.5,4.75,21.75,14.27,27.73,16.51,8.99,28.53,21.99,36.03,38.97,7.51,17,11.26,46.21,11.26,87.67v417.4c-3.52,17.5-9.02,31.11-16.53,40.85-7.51,9.73-17.51,17.85-30.02,24.35-10.02,6-15.02,14.99-15.02,26.97,0,18.5,10.25,27.73,30.79,27.73l158.39.74,158.41-.74c21.02,0,31.53-8.73,31.53-26.23,0-12.98-5.27-22.48-15.77-28.47Z"></path>
								<path pathLength="1" class="hla-isela-path" style="animation-delay: 1.89s" d="M1494.86,1025.36c-76.09-.98-136.77-9.19-182.06-24.61-45.31-15.42-77.96-35.01-97.98-58.75-20.02-23.74-30.02-47.37-30.02-70.89,0-28.87,8.38-50.79,25.14-65.72,16.76-14.93,35.91-22.41,57.44-22.41,20,0,38.03,6.37,54.04,19.1,16.02,12.74,24.02,32.08,24.02,58.02,0,28.89,6.25,52.27,18.77,70.14,12.51,17.88,29.65,31.11,51.43,39.67,21.76,8.57,46.66,13.11,74.68,13.58,47.55,0,84.58-11.51,111.11-34.52,26.51-23.01,39.79-49.44,39.79-79.32,0-35.74-18.03-63.15-54.04-82.27-39.04-21.04-79.85-38.92-122.38-53.61-40.04-14.2-78.58-30.97-115.61-50.3-37.05-19.33-69.33-46.15-96.84-80.43-31.03-38.67-46.55-77.35-46.55-116.04,0-84.21,34.77-146.16,104.35-185.81,57.55-32.8,129.62-49.21,216.21-49.21,55.56,0,102.71,7.1,141.5,21.3,38.79,14.2,68.56,32.06,89.35,53.61,20.77,21.55,31.16,44.31,31.16,68.3,0,30.37-8.9,53.61-26.66,69.78-17.76,16.17-39.17,24.23-64.19,24.23-23.03,0-43.67-7.83-61.93-23.5-18.28-15.66-27.4-39.9-27.4-72.71,0-66.1-27.03-99.16-81.07-99.16-47.05,0-80.84,11.76-101.36,35.26-15.02,17.62-22.51,36.97-22.51,58.02,0,44.07,22.76,78.35,68.31,102.82,39.02,21.06,79.81,39.18,122.36,54.34,40.04,14.2,78.44,30.86,115.24,49.95,36.78,19.1,68.94,45.78,96.47,80.05,31.03,38.68,46.55,77.61,46.55,116.78,0,83.23-41.3,144.93-123.87,185.07-66.57,32.82-144.39,49.22-233.47,49.22Z"></path>
								<path pathLength="1" class="hla-isela-path" style="animation-delay: 1.98s" d="M2263.3,1025.11c-67.57,0-129.64-13.5-186.19-40.5-56.55-27-103.35-68.46-140.38-124.39-41.03-67.01-61.55-138.61-61.55-214.79,0-10.61.5-21.46,1.49-32.55,9.5-109.44,50.93-196.94,124.24-262.51,73.31-65.57,166.79-98.36,280.39-98.36,65.56,0,120.86,10.25,165.92,30.74,45.04,20.49,80.08,46.88,105.1,79.18,29.02,38.09,43.54,80.04,43.54,125.84,0,29.9-7.76,60.52-23.28,91.85-15.52,31.34-42.55,59.43-81.09,84.25-38.54,24.83-88.08,41.1-148.62,48.81-20.04,2.9-41.05,4.34-63.06,4.34-45.55,0-95.84-5.77-150.9-17.35,10,34.24,25.14,64.96,45.41,92.21,20.27,27.25,46.43,48.94,78.46,65.09,32.03,16.15,70.06,24.22,114.12,24.22,65.06,0,125.86-17.35,182.41-52.08,5.5-3.37,11-5.06,16.51-5.06,4,0,7.76,1.2,11.26,3.6,6,4.36,9,10.15,9,17.37,0,3.37-1,6.74-2.99,10.11-36.55,52.56-82.71,94.04-138.52,124.41-55.8,30.35-116.24,45.55-181.29,45.55ZM2118.41,661.48c102.09,0,176.4-29.12,222.95-87.35,29.52-40.24,44.29-88.3,44.29-144.18,0-77.63-33.03-117.88-99.08-120.73-41.55,1.43-76.71,19.89-105.49,55.4-28.77,35.51-47.55,73.74-56.3,114.69-8.76,40.96-13.13,76.12-13.13,105.47,0,25.58,2.24,51.14,6.76,76.7Z"></path>
								<path pathLength="1" class="hla-isela-path" style="animation-delay: 2.07s" d="M2763.48,1011.86l-158.41-.74c-21.03,0-31.53-8.69-31.53-26.1,0-12.92,5.25-22.36,15.77-28.33,25.02-13.42,40.54-35.04,46.55-64.87V220.7c0-41.25-3.88-70.33-11.64-87.24-7.76-16.89-19.89-29.83-36.41-38.78-9.52-6.45-14.27-15.4-14.27-26.84,0-18.39,9.75-27.59,29.27-27.59,78.08,0,160.9-13.16,248.49-39.52l6.76-.74c11.5,0,19.88,3.11,25.14,9.32,5.25,6.21,7.88,18.26,7.88,36.15v846.35c5,29.83,20.52,51.46,46.55,64.87,10,6.47,15.02,15.41,15.02,26.84,0,18.41-10.52,27.59-31.53,27.59l-157.64.74Z"></path>
								<path pathLength="1" class="hla-isela-path" style="animation-delay: 2.16s" d="M3531.82,1024.1c-25.54,0-49.31-4.57-71.34-13.7-22.03-9.13-39.91-23.72-53.67-43.79-13.77-20.04-21.14-46.58-22.14-79.57-54.06,91.39-130.88,137.06-230.48,137.06-42.05,0-78.96-9.38-110.74-28.16-31.78-18.78-56.55-43.41-74.31-73.87-17.78-30.46-26.66-63.45-26.66-98.99,0-50.24,10.87-89.71,32.65-118.39,21.78-28.69,50.43-51.15,85.97-67.4,35.52-16.23,74.31-29.93,116.36-41.11,79.08-18.78,135.13-38.58,168.16-59.39,20.02-12.17,33.28-26.14,39.79-41.88.5-25.37.75-51.51.75-78.42,0-19.29-2.51-38.31-7.51-57.11-5.02-18.78-14.4-34.52-28.15-47.2-13.77-12.68-32.9-19.04-57.42-19.04-22.53,0-40.93,6.1-55.18,18.27-14.27,12.19-24.77,28.05-31.53,47.6-6.76,19.55-10.13,40.48-10.13,62.81,0,34.01-9.15,59.15-27.4,75.38-18.28,16.25-39.17,24.37-62.69,24.37-25.02,0-46.55-7.98-64.56-23.99-18.03-15.99-27.03-40.22-27.03-72.72,0-27.9,10.87-55.05,32.65-81.46,21.78-26.39,53.69-48.22,95.72-65.49,42.03-17.25,93.58-25.89,154.65-25.89,91.07,0,168.91,23.1,233.47,69.3,72.57,52.79,108.87,126.4,108.87,220.8v328.95c0,19.8,3.74,33.37,11.25,40.73,7.51,7.36,18.52,13.32,33.05,17.89,10,4.08,15,11.68,15,22.86,0,21.82-25.54,40.86-76.57,57.09-29.04,9.66-59.31,14.48-90.82,14.48ZM3264.56,898.45c48.54,0,88.58-36.8,120.12-110.41,0-103.03.25-179.43.75-229.18-21.03,16.25-44.04,28.93-69.06,38.07-41.55,17.78-72.34,42.9-92.34,75.38-23.52,37.07-35.29,75.14-35.29,114.22,0,28.42,6.25,54.19,18.76,77.29,12.51,23.1,31.53,34.63,57.07,34.63Z"></path>
							</g>

							<g class="hla-trailing-fill">
								<ellipse class="hla-dot-fill" cx="963.34" cy="104.71" rx="137.09" ry="101.62" transform="translate(6.88 260.21) rotate(-15.44)"></ellipse>
								<text class="hla-subtitle-fill" transform="translate(857.3973 1325.3391) scale(.7839 .7)">
									<tspan x="0" y="0" style="letter-spacing:.21em">P</tspan><tspan x="190.84" y="0" style="letter-spacing:.28em">ASTELERÍA</tspan>
								</text>
								<text class="hla-subtitle-fill" transform="translate(2523.3045 1325.3391) scale(.7839 .7)">
									<tspan x="0" y="0" style="letter-spacing:.28em">N</tspan><tspan x="243.86" y="0" style="letter-spacing:.2em">A</tspan><tspan x="468.38" y="0" style="letter-spacing:.28em">TURAL</tspan>
								</text>
							</g>
						</g>
					</svg>
				) : (
					<Image src={logo} alt="Gisela Pastelería Natural" width={220} height={98} class="h-10 w-auto md:h-12" />
				)
			}
		</a>

		<nav class="hidden md:block">
			<ul class="flex items-center gap-8 font-medium text-sage-700">
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href} class="header-nav-link rounded-full transition-colors hover:text-sage-500">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="hidden items-center gap-3 md:flex">
			<LanguageSwitcher lang={lang} path={canonicalPath} />
			<a
				href={cartaHref}
				class="ripple rounded-full bg-sage-400 px-5 py-2 text-center font-medium text-white transition-colors hover:bg-sage-500"
			>
				{t('nav.carta')}
			</a>
		</div>

		<input type="checkbox" id="menu-toggle" class="peer hidden" />
		<label
			for="menu-toggle"
			aria-label={t('aria.openMenu')}
			class="header-menu-toggle grid h-10 w-10 cursor-pointer place-items-center rounded-full text-sage-700 hover:bg-sage-100 md:hidden"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
				<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		</label>

		<nav
			class="absolute inset-x-0 top-full hidden border-b border-sage-100 bg-cream-50 peer-checked:block md:hidden"
		>
			<ul class="flex flex-col gap-1 px-4 py-4 font-medium text-sage-700">
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href} class="block rounded-lg px-3 py-2 hover:bg-sage-100">
								{link.label}
							</a>
						</li>
					))
				}
				<li class="px-3 py-2">
					<LanguageSwitcher lang={lang} path={canonicalPath} />
				</li>
				<li>
					<a href={cartaHref} class="ripple mt-2 block rounded-full bg-sage-400 px-3 py-2 text-center text-white hover:bg-sage-500">
						{t('nav.carta')}
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>

<style>
	.hla-icon-group {
		transform: translateX(1460px);
		transform-origin: center;
		animation: hla-slide-left 0.5s ease-out forwards;
		animation-delay: 1.3s;
	}

	.hla-icon-path {
		fill: var(--color-sage-400);
		fill-opacity: 0;
		stroke: var(--color-sage-400);
		stroke-width: 42;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		stroke-opacity: 1;
		animation: hla-draw-fill 1.3s ease-in-out forwards;
	}

	.hla-isela-path {
		fill: var(--color-terracotta-400);
		fill-opacity: 0;
		stroke: var(--color-terracotta-400);
		stroke-width: 42;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		stroke-opacity: 1;
		animation: hla-draw-fill 0.65s ease-in-out forwards;
	}

	.hla-dot-fill {
		fill: var(--color-sage-400);
	}
	.hla-subtitle-fill {
		fill: var(--color-terracotta-400);
		font-family: 'CenturyGothicPro', 'Century Gothic Pro', var(--font-sans);
		font-size: 238.85px;
	}

	.hla-trailing-fill {
		opacity: 0;
		transform: translateY(20px);
		animation: hla-rest-reveal 0.5s ease-out forwards;
		animation-delay: 2.6s;
	}

	@keyframes hla-draw-fill {
		0% {
			stroke-dashoffset: 1;
			fill-opacity: 0;
		}
		60% {
			stroke-dashoffset: 0;
			fill-opacity: 0;
		}
		100% {
			fill-opacity: 1;
			stroke-opacity: 0;
		}
	}

	@keyframes hla-slide-left {
		from {
			transform: translateX(1460px);
		}
		to {
			transform: translateX(0);
		}
	}

	@keyframes hla-rest-reveal {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hla-icon-group {
			transform: translateX(0);
			animation: none;
		}
		.hla-icon-path {
			fill-opacity: 1;
			stroke-opacity: 0;
			stroke-dashoffset: 0;
			animation: none;
		}
		.hla-trailing-fill {
			opacity: 1;
			transform: translateY(0);
			animation: none;
		}
	}

	.header-nav-link {
		padding: 0.35rem 0.9rem;
		background-color: rgba(253, 248, 240, 0.28);
		box-shadow: 0 1px 3px rgba(38, 58, 51, 0.08);
	}

	.header :global(.lang-switcher-trigger) {
		background-color: rgba(253, 248, 240, 0.28);
	}

	.header-menu-toggle {
		background-color: rgba(253, 248, 240, 0.28);
		box-shadow: 0 1px 3px rgba(38, 58, 51, 0.08);
	}
</style>
