---
import { Image } from 'astro:assets';
import alan from '../assets/Imágenes de ejemplo/Alan chupando dedo.jpg';
import { useTranslations, defaultLocale, type Locale } from '../i18n/utils';

interface Props {
	lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
---

<section id="historia" class="relative bg-cream-100 py-16 md:py-24">
	<div class="mx-auto grid max-w-6xl items-center gap-10 px-4 md:grid-cols-2 md:px-6 md:gap-16">
		<div data-reveal class="overflow-hidden rounded-2xl">
			<Image
				src={alan}
				alt={t('historia.imageAlt')}
				width={1200}
				widths={[480, 800, 1200]}
				sizes="(min-width: 768px) 50vw, 100vw"
				quality={65}
				class="h-full w-full object-cover"
			/>
		</div>

		<div data-reveal class="flex flex-col gap-4">
			<span class="text-sm font-medium uppercase tracking-widest text-terracotta-500">
				{t('historia.eyebrow')}
			</span>
			<h2 class="font-display text-3xl text-sage-900 md:text-4xl">
				{t('historia.title')}
			</h2>
			<p class="text-sage-700">{t('historia.p1')}</p>
			<p class="text-sage-700">{t('historia.p2')}</p>
		</div>
	</div>
</section>
