---
import { locales, localeNames, getLocalizedPath, type Locale } from '../i18n/utils';

interface Props {
	lang: Locale;
	path: string;
}

const { lang, path } = Astro.props;
---

<details class="group relative">
	<summary
		class="lang-switcher-trigger flex cursor-pointer list-none items-center gap-1 rounded-full border border-sage-200 px-3 py-1.5 text-sm font-medium text-sage-700 transition-colors hover:bg-sage-100 [&::-webkit-details-marker]:hidden"
	>
		<span class="uppercase">{lang}</span>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5">
			<path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7" />
		</svg>
	</summary>

	<ul
		class="absolute right-0 z-30 mt-2 w-40 overflow-hidden rounded-xl border border-sage-100 bg-white py-1 shadow-lg"
	>
		{
			locales.map((locale) => (
				<li>
					<a
						href={getLocalizedPath(path, locale)}
						class={`block px-4 py-2 text-sm hover:bg-sage-100 ${locale === lang ? 'font-semibold text-sage-700' : 'text-sage-600'}`}
					>
						{localeNames[locale]}
					</a>
				</li>
			))
		}
	</ul>
</details>
