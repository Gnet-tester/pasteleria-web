---
import { getGoogleReviews } from '../lib/googlePlaces';
import { useTranslations, defaultLocale, type Locale } from '../i18n/utils';

interface Props {
	lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

const data = await getGoogleReviews();
const featuredReviews = (data?.reviews ?? []).filter((r) => r.rating === 5).slice(0, 3);

function Stars({ rating }: { rating: number }) {
	return '★'.repeat(Math.round(rating)) + '☆'.repeat(5 - Math.round(rating));
}
---

<section id="opiniones" class="flour-texture py-16 md:py-24">
	<div data-reveal class="mx-auto max-w-6xl px-4 md:px-6">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="font-display text-3xl text-sage-900 md:text-4xl">{t('reviews.title')}</h2>
			{
				data ? (
					<p class="mt-3 flex items-center justify-center gap-2 text-sage-700">
						<span class="text-xl text-terracotta-400">{Stars({ rating: data.rating })}</span>
						<span class="font-medium">{data.rating.toFixed(1)}</span>
						<span>
							· {data.totalReviews} {t('reviews.countSuffix')}
						</span>
					</p>
				) : (
					<p class="mt-3 text-sage-700">{t('reviews.fallbackSubtitle')}</p>
				)
			}
		</div>

		{
			featuredReviews.length > 0 ? (
				<div class="mt-10 grid gap-6 md:grid-cols-3">
					{featuredReviews.map((review, i) => (
						<article class="flex flex-col gap-3 rounded-2xl border border-sage-100 bg-white p-6 shadow-sm">
							<div class="flex items-center gap-3">
								{review.authorPhotoUrl ? (
									<img
										src={review.authorPhotoUrl}
										alt=""
										width="40"
										height="40"
										class="h-10 w-10 rounded-full"
										loading="lazy"
									/>
								) : (
									<div class="grid h-10 w-10 place-items-center rounded-full bg-sage-100 font-medium text-sage-600">
										{review.authorName.charAt(0)}
									</div>
								)}
								<div>
									<p class="font-medium text-sage-900">{review.authorName}</p>
									<p class="text-xs text-sage-500">{review.relativeTime}</p>
								</div>
							</div>
							<p class="text-terracotta-400">{Stars({ rating: review.rating })}</p>

							<input type="checkbox" id={`review-${i}`} class="peer hidden" />
							<p
								data-review-text
								class="line-clamp-5 text-sm leading-relaxed text-sage-700 peer-checked:line-clamp-none"
							>
								{review.text}
							</p>
							<label
								for={`review-${i}`}
								data-review-toggle
								class="hidden cursor-pointer self-start text-sm font-medium text-terracotta-500 hover:underline peer-checked:hidden"
							>
								{t('reviews.verMas')}
							</label>
						</article>
					))}
				</div>
			) : (
				<div class="mx-auto mt-10 max-w-xl rounded-2xl border border-sage-100 bg-white p-8 text-center">
					<p class="text-sage-700">{t('reviews.fallbackText')}</p>
				</div>
			)
		}

		<div class="mt-10 text-center">
			<a
				href={data?.placeUrl ?? 'https://www.google.com/search?q=Gisela+Pasteler%C3%ADa+Natural+Ponferrada'}
				target="_blank"
				rel="noopener noreferrer"
				class="ripple inline-block rounded-full border border-sage-300 px-6 py-2.5 text-center font-medium text-sage-700 transition-colors hover:bg-sage-100"
			>
				{t('reviews.verTodas')}
			</a>
		</div>
	</div>

	<script>
		document.querySelectorAll<HTMLElement>('[data-review-text]').forEach((el) => {
			if (el.scrollHeight > el.clientHeight + 1) {
				const label = el.nextElementSibling as HTMLElement | null;
				label?.classList.remove('hidden');
			}
		});
	</script>
</section>
