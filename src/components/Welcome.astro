						<path pathLength="1" class="isela-path" style="animation-delay: 2.16s" d="M3531.82,1024.1c-25.54,0-49.31-4.57-71.34-13.7-22.03-9.13-39.91-23.72-53.67-43.79-13.77-20.04-21.14-46.58-22.14-79.57-54.06,91.39-130.88,137.06-230.48,137.06-42.05,0-78.96-9.38-110.74-28.16-31.78-18.78-56.55-43.41-74.31-73.87-17.78-30.46-26.66-63.45-26.66-98.99,0-50.24,10.87-89.71,32.65-118.39,21.78-28.69,50.43-51.15,85.97-67.4,35.52-16.23,74.31-29.93,116.36-41.11,79.08-18.78,135.13-38.58,168.16-59.39,20.02-12.17,33.28-26.14,39.79-41.88.5-25.37.75-51.51.75-78.42,0-19.29-2.51-38.31-7.51-57.11-5.02-18.78-14.4-34.52-28.15-47.2-13.77-12.68-32.9-19.04-57.42-19.04-22.53,0-40.93,6.1-55.18,18.27-14.27,12.19-24.77,28.05-31.53,47.6-6.76,19.55-10.13,40.48-10.13,62.81,0,34.01-9.15,59.15-27.4,75.38-18.28,16.25-39.17,24.37-62.69,24.37-25.02,0-46.55-7.98-64.56-23.99-18.03-15.99-27.03-40.22-27.03-72.72,0-27.9,10.87-55.05,32.65-81.46,21.78-26.39,53.69-48.22,95.72-65.49,42.03-17.25,93.58-25.89,154.65-25.89,91.07,0,168.91,23.1,233.47,69.3,72.57,52.79,108.87,126.4,108.87,220.8v328.95c0,19.8,3.74,33.37,11.25,40.73,7.51,7.36,18.52,13.32,33.05,17.89,10,4.08,15,11.68,15,22.86,0,21.82-25.54,40.86-76.57,57.09-29.04,9.66-59.31,14.48-90.82,14.48ZM3264.56,898.45c48.54,0,88.58-36.8,120.12-110.41,0-103.03.25-179.43.75-229.18-21.03,16.25-44.04,28.93-69.06,38.07-41.55,17.78-72.34,42.9-92.34,75.38-23.52,37.07-35.29,75.14-35.29,114.22,0,28.42,6.25,54.19,18.76,77.29,12.51,23.1,31.53,34.63,57.07,34.63Z"></path>
