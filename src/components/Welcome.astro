						<ellipse class="dot-fill" cx="963.34" cy="104.71" rx="137.09" ry="101.62" transform="translate(6.88 260.21) rotate(-15.44)"></ellipse>

						<text class="subtitle-fill" transform="translate(857.3973 1325.3391) scale(.7839 .7)">
							<tspan x="0" y="0" style="letter-spacing:.21em">P</tspan><tspan x="190.84" y="0" style="letter-spacing:.28em">ASTELERÍA</tspan>
						</text>
						<text class="subtitle-fill" transform="translate(2523.3045 1325.3391) scale(.7839 .7)">
							<tspan x="0" y="0" style="letter-spacing:.28em">N</tspan><tspan x="243.86" y="0" style="letter-spacing:.2em">A</tspan><tspan x="468.38" y="0" style="letter-spacing:.28em">TURAL</tspan>
						</text>
