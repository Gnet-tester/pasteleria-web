---
import { Image } from 'astro:assets';
import leaf from '../assets/Favicon.svg';
import heroBg from '../assets/Imágenes de ejemplo/Foto 33.jpg';
import { useTranslations, getLocalizedPath, defaultLocale, type Locale } from '../i18n/utils';

interface Props {
	lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
---

<section id="inicio" class="relative h-[160vh]">
	<div class="sticky top-0 h-screen w-full overflow-hidden">
		<Image
			src={heroBg}
			alt=""
			class="absolute inset-0 h-full w-full object-cover"
			width={1920}
			widths={[640, 1024, 1920]}
			sizes="100vw"
			quality={70}
			loading="eager"
			fetchpriority="high"
		/>
		<div class="absolute inset-0 bg-sage-900/55"></div>

		<div
			class="relative z-10 flex h-full flex-col items-center justify-center gap-8 px-4 text-center text-cream-50 md:px-6"
		>
			<span
				class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium backdrop-blur"
			>
				<Image src={leaf} alt="" width={18} height={18} class="h-4 w-4" />
				{t('hero.badge')}
			</span>

			<h1 class="max-w-3xl font-display text-4xl leading-tight md:text-6xl">
				{t('hero.title')}
			</h1>

			<p class="max-w-2xl text-lg text-cream-100 md:text-xl">
				{t('hero.subtitle')}
			</p>

			<div class="flex flex-col gap-3 sm:flex-row">
				<a
					href={getLocalizedPath('/historia', lang)}
					class="ripple rounded-full bg-sage-400 px-8 py-3 font-medium text-white shadow-sm transition-colors hover:bg-sage-500"
				>
					{t('historia.eyebrow')}
				</a>
				<a
					href="https://www.instagram.com/gisela.pastelerianatural"
					target="_blank"
					rel="noopener noreferrer"
					class="ripple rounded-full border border-white/40 px-8 py-3 font-medium transition-colors hover:bg-white/10"
				>
					{t('hero.ctaInstagram')}
				</a>
			</div>

			<span class="absolute bottom-8 left-1/2 -translate-x-1/2 text-xs uppercase tracking-widest text-cream-100/70">
				{t('hero.scroll')}
			</span>
		</div>
	</div>
</section>
