		</div>
	</div>
</section>

<script>
	const heroSection = document.getElementById('inicio');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (heroSection && !reducedMotion) {
		const finishIntro = () => {
			heroSection.classList.add('intro-done');
			window.dispatchEvent(new Event('hero-logo:landed'));
		};

		const flyToHeader = () => {
			const svgFlight = document.querySelector<SVGSVGElement>('[data-logo-flight]');
			const headerLogo = document.querySelector<HTMLElement>('[data-header-logo]');
			if (!svgFlight || !headerLogo) {
				finishIntro();
				return;
			}

			const sourceRect = svgFlight.getBoundingClientRect();
			const targetRect = headerLogo.getBoundingClientRect();
			const scale = targetRect.width / sourceRect.width;
			const translateX = targetRect.left - sourceRect.left;
			const translateY = targetRect.top - sourceRect.top;

			svgFlight.style.position = 'fixed';
			svgFlight.style.top = `${sourceRect.top}px`;
			svgFlight.style.left = `${sourceRect.left}px`;
			svgFlight.style.width = `${sourceRect.width}px`;
			svgFlight.style.height = `${sourceRect.height}px`;
			svgFlight.style.maxWidth = 'none';
			svgFlight.style.margin = '0';
			svgFlight.style.padding = '0';
			svgFlight.style.zIndex = '9999';
			svgFlight.style.transformOrigin = '0 0';
			svgFlight.style.transition = 'transform 0.5s cubic-bezier(0.65, 0, 0.35, 1)';

			requestAnimationFrame(() => {
				svgFlight.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
			});

			window.setTimeout(finishIntro, 500);
		};

		heroSection.classList.add('intro-playing');
		window.setTimeout(flyToHeader, 3500);
	}
</script>

<style>
	.hero-content {
		opacity: 0;
		transform: translateY(12px);
		transition:
			opacity 0.5s ease,
			transform 0.5s ease;
	}

	#inicio.intro-done .hero-content {
		opacity: 1;
		transform: translateY(0);
	}

	.hero-intro {
		opacity: 1;
		transition: opacity 0.45s ease;
	}

	#inicio.intro-done .hero-intro {
		opacity: 0;
		pointer-events: none;
	}

	.icon-group {
		transform: translateX(1460px);
		transform-origin: center;
	}

	.icon-path {
		fill: var(--color-sage-400);
		fill-opacity: 0;
		stroke: var(--color-sage-400);
		stroke-width: 42;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		stroke-opacity: 1;
	}

	.isela-path {
		fill: var(--color-terracotta-400);
		fill-opacity: 0;
		stroke: var(--color-terracotta-400);
		stroke-width: 42;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		stroke-opacity: 1;
	}

	.dot-fill {
		fill: var(--color-sage-400);
	}
	.subtitle-fill {
		fill: var(--color-terracotta-400);
		font-family: 'CenturyGothicPro', 'Century Gothic Pro', var(--font-sans);
		font-size: 238.85px;
	}

	.trailing-fill {
		opacity: 0;
		transform: translateY(20px);
	}

	#inicio.intro-playing .icon-path {
		animation: draw-fill 1.3s ease-in-out forwards;
	}

	#inicio.intro-playing .icon-group {
		animation: slide-left 0.5s ease-out forwards;
		animation-delay: 1.3s;
	}

	#inicio.intro-playing .isela-path {
		animation: draw-fill 0.65s ease-in-out forwards;
	}

	#inicio.intro-playing .trailing-fill {
		animation: rest-reveal 0.5s ease-out forwards;
		animation-delay: 2.6s;
	}

	@keyframes draw-fill {
		0% {
			stroke-dashoffset: 1;
			fill-opacity: 0;
		}
		60% {
			stroke-dashoffset: 0;
			fill-opacity: 0;
		}
		100% {
			fill-opacity: 1;
			stroke-opacity: 0;
		}
	}

	@keyframes slide-left {
		from {
			transform: translateX(1460px);
		}
		to {
			transform: translateX(0);
		}
	}

	@keyframes rest-reveal {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-intro {
			display: none;
		}
		.hero-content {
			opacity: 1;
			transform: translateY(0);
			transition: none;
		}
	}
</style>
