---
import { Image } from 'astro:assets';
import leaf from '../assets/Favicon.svg';
import tartaManzana from '../assets/Tarta de manzana.jpg';
import cajaPastas from '../assets/Imágenes de ejemplo/Caja de pastas.jpg';
import { getGoogleReviews } from '../lib/googlePlaces';
import { useTranslations, getLocalizedPath, defaultLocale, type Locale } from '../i18n/utils';

interface Props {
	lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const reviews = await getGoogleReviews();
---

<section id="inicio" class="relative overflow-hidden bg-cream-50">
	<Image
		src={cajaPastas}
		alt=""
		class="absolute inset-0 h-full w-full object-cover"
		width={1920}
		widths={[640, 1024, 1920]}
		sizes="100vw"
		quality={60}
		loading="eager"
		fetchpriority="high"
	/>
	<div class="absolute inset-0 bg-cream-50/60"></div>

	<div
		class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-24 md:grid-cols-2 md:gap-16 md:px-6 md:py-32"
	>
		<div class="order-2 flex flex-col items-start gap-6 text-left md:order-1">
			<div class="flex flex-wrap gap-2">
				<span
					class="inline-flex items-center gap-2 rounded-full bg-sage-100 px-4 py-1.5 text-sm font-medium text-sage-700"
				>
					<Image src={leaf} alt="" width={20} height={20} class="h-5 w-5" />
					{t('hero.badge1')}
				</span>
				<span
					class="inline-flex items-center gap-2 rounded-full bg-terracotta-50 px-4 py-1.5 text-sm font-medium text-terracotta-600"
				>
					{t('hero.badge2')}
				</span>
			</div>

			<h1 class="max-w-xl font-display text-4xl leading-tight text-sage-900 md:text-5xl lg:text-6xl">
				{t('hero.title')}
			</h1>

			<p class="max-w-xl text-lg text-sage-700">
				{t('hero.subtitle')}
			</p>

			{
				reviews && (
					<div class="flex items-center gap-4 rounded-2xl border border-terracotta-100 bg-white px-5 py-4 shadow-md">
						<span class="font-display text-5xl leading-none text-terracotta-500">
							{reviews.rating.toFixed(1)}
						</span>
						<div class="flex flex-col gap-0.5">
							<span class="text-lg leading-none text-terracotta-400" aria-hidden="true">
								★★★★★
							</span>
							<span class="text-sm font-medium text-sage-600">
								{reviews.totalReviews} {t('reviews.countSuffix')}
							</span>
						</div>
					</div>
				)
			}

			<div class="flex flex-col gap-3 sm:flex-row">
				<a
					href={getLocalizedPath('/historia', lang)}
					class="ripple rounded-full bg-sage-400 px-8 py-3 text-center font-medium text-white shadow-sm transition-colors hover:bg-sage-500"
				>
					{t('historia.eyebrow')}
				</a>
				<a
					href="https://www.instagram.com/gisela.pastelerianatural"
					target="_blank"
					rel="noopener noreferrer"
					class="ripple rounded-full border border-sage-300 px-8 py-3 text-center font-medium text-sage-700 transition-colors hover:bg-sage-100"
				>
					{t('hero.ctaInstagram')}
				</a>
			</div>
		</div>

		<div class="order-1 md:order-2">
			<div
				class="hero-parallax-frame relative mx-auto h-80 max-w-sm overflow-hidden rounded-[2rem] shadow-xl sm:h-96 md:h-[560px] md:max-w-none"
			>
				<div class="hero-parallax-layer" data-parallax-speed="0.12">
					<Image
						src={tartaManzana}
						alt={t('hero.imageAlt')}
						width={900}
						widths={[480, 700, 900]}
						sizes="(min-width: 768px) 40vw, 80vw"
						quality={72}
						loading="eager"
						fetchpriority="high"
						class="h-full w-full object-cover"
					/>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const heroSection = document.getElementById('inicio');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const parallaxLayers = document.querySelectorAll<HTMLElement>('#inicio [data-parallax-speed]');
	if (parallaxLayers.length && heroSection && !reducedMotion) {
		let ticking = false;
		let active = false;

		const update = () => {
			ticking = false;
			parallaxLayers.forEach((el) => {
				const speed = parseFloat(el.dataset.parallaxSpeed || '0.1');
				const frame = el.parentElement as HTMLElement;
				const rect = frame.getBoundingClientRect();
				const distanceFromCenter = rect.top + rect.height / 2 - window.innerHeight / 2;
				const maxOffset = rect.height * 0.16;
				const offset = Math.max(-maxOffset, Math.min(maxOffset, distanceFromCenter * speed));
				el.style.transform = `translateY(${offset}px)`;
			});
		};

		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting && !active) {
						active = true;
						window.addEventListener('scroll', onScroll, { passive: true });
						update();
					} else if (!entry.isIntersecting && active) {
						active = false;
						window.removeEventListener('scroll', onScroll);
					}
				}
			},
			{ rootMargin: '25% 0px 25% 0px' }
		);
		observer.observe(heroSection);
	}
</script>

<style>
	.hero-parallax-layer {
		position: absolute;
		inset: -18% 0;
		height: 136%;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-parallax-layer {
			position: static;
			inset: auto;
			height: 100%;
			transform: none !important;
		}
	}
</style>
