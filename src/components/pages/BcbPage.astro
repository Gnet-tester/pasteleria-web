---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import leaf from '../../assets/Favicon.svg';
import pilgrimIcon from '../../assets/bcb/icon.png';
import { useTranslations, defaultLocale, type Locale } from '../../i18n/utils';

interface Props {
	lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

interface Tier {
	nameKey: string;
	descKey: string;
	price: number;
	link: string | undefined;
}

const tiers: Tier[] = [
	{
		nameKey: 'tier.sencillo.name',
		descKey: 'tier.sencillo.desc',
		price: 6.5,
		link: import.meta.env.PUBLIC_STRIPE_BCB_LINK_SENCILLO
	},
	{
		nameKey: 'tier.completo.name',
		descKey: 'tier.completo.desc',
		price: 11.9,
		link: import.meta.env.PUBLIC_STRIPE_BCB_LINK_COMPLETO
	},
	{
		nameKey: 'tier.premium.name',
		descKey: 'tier.premium.desc',
		price: 16.9,
		link: import.meta.env.PUBLIC_STRIPE_BCB_LINK_PREMIUM
	}
];

const formatPrice = (price: number) =>
	price.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '€';
---

<Layout lang={lang} title={t('bcbPage.title')} description={t('bcbPage.description')}>
	<Header lang={lang} />

	<main class="bg-sage-800 py-20 text-cream-100 md:py-28">
		<div class="relative mx-auto max-w-3xl px-4 text-center md:px-6">
			<div data-reveal class="flex flex-col items-center gap-4">
				<div class="grid place-items-center rounded-full bg-cream-50 p-6 shadow-lg">
					<Image src={pilgrimIcon} alt="" width={220} height={311} class="h-28 w-auto sm:h-36" />
				</div>
				<span class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.2em] text-sage-300">
					<Image src={leaf} alt="" width={16} height={16} class="h-4 w-4" />
					{t('bcbPage.poweredBy')}
				</span>
			</div>

			<h1 data-reveal class="mt-6 font-display text-4xl leading-tight md:text-6xl">
				{t('bcbTeaser.title')}
			</h1>

			<p data-reveal class="mx-auto mt-6 max-w-xl text-lg text-sage-200">
				{t('bcbPage.intro')}
			</p>
		</div>

		<div class="relative mx-auto mt-16 max-w-6xl px-4 md:px-6">
			<div data-reveal class="grid gap-6 md:grid-cols-3">
				{
					tiers.map((tier) => (
						<div class="flex flex-col gap-4 rounded-2xl border border-white/15 bg-white/5 p-6">
							<div>
								<h2 class="font-display text-xl">{t(tier.nameKey)}</h2>
								<p class="mt-2 text-sm text-sage-200">{t(tier.descKey)}</p>
							</div>
							<p class="font-display text-3xl">{formatPrice(tier.price)}</p>
							{tier.link ? (
								<a
									href={tier.link}
									target="_blank"
									rel="noopener noreferrer"
									class="ripple mt-auto rounded-full bg-terracotta-400 px-6 py-2.5 text-center font-medium text-white transition-colors hover:bg-terracotta-500"
								>
									{t('bcbPage.regalar')}
								</a>
							) : (
								<span class="mt-auto rounded-full bg-white/10 px-6 py-2.5 text-center font-medium text-sage-300">
									{t('bcbPage.proximamente')}
								</span>
							)}
						</div>
					))
				}
			</div>

			<p class="mt-8 text-center text-xs text-sage-300">{t('bcbPage.disclaimer')}</p>
		</div>
	</main>

	<Footer lang={lang} />
</Layout>
