---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import verrines from '../../assets/Imágenes de ejemplo/foto 348.jpg';
import cajaRegalo from '../../assets/Imágenes de ejemplo/Caja de pastas.jpg';
import placeholder5 from '../../assets/placeholders/placeholder-5.jpg';
import { useTranslations, getLocalizedPath, defaultLocale, type Locale } from '../../i18n/utils';

interface Props {
	lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

const items = [
	{
		slug: 'dulces',
		image: verrines,
		alt: t('especialidades.item1.alt'),
		title: t('especialidades.item1.title'),
		description: t('especialidades.item1.desc')
	},
	{
		slug: 'regalar',
		image: cajaRegalo,
		alt: t('especialidades.item2.alt'),
		title: t('especialidades.item2.title'),
		description: t('especialidades.item2.desc')
	},
	{
		slug: 'cafe',
		image: placeholder5,
		alt: t('especialidades.item3.alt'),
		title: t('especialidades.item3.title'),
		description: t('especialidades.item3.desc')
	}
];
---

<Layout lang={lang} title={t('meta.especialidades.title')} description={t('meta.especialidades.description')}>
	<Header lang={lang} />

	<main class="bg-cream-50">
		<section class="py-16 text-center md:py-24">
			<div class="mx-auto max-w-2xl px-4 md:px-6">
				<span class="text-sm font-medium uppercase tracking-widest text-terracotta-500">
					{t('especialidades.eyebrow')}
				</span>
				<h1 class="mt-2 font-display text-4xl text-sage-900 md:text-5xl">{t('especialidades.title')}</h1>
				<p class="mx-auto mt-4 max-w-xl text-sage-700">{t('especialidadesPage.intro')}</p>
			</div>
		</section>

		<nav class="sticky top-[65px] z-40 border-y border-sage-100 bg-cream-50">
			<ul class="mx-auto flex max-w-4xl gap-2 overflow-x-auto px-4 py-3 md:px-6">
				{
					items.map((item) => (
						<li>
							<a
								href={`#${item.slug}`}
								class="block whitespace-nowrap rounded-full border border-sage-200 px-4 py-1.5 text-sm font-medium text-sage-700 transition-colors hover:bg-sage-100"
							>
								{item.title}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<section class="pb-16 md:pb-24">
			<div class="mx-auto max-w-5xl px-4 md:px-6">
				{
					items.map((item, index) => (
						<div
							id={item.slug}
							class="grid scroll-mt-32 items-center gap-10 border-t border-sage-100 py-14 first:border-t-0 first:pt-16 last:pb-0 md:grid-cols-2 md:gap-16"
						>
							<div class={index % 2 === 1 ? 'md:order-2' : ''}>
								<div class="overflow-hidden rounded-2xl border-4 border-white shadow-lg">
									<Image
										src={item.image}
										alt={item.alt}
										width={900}
										widths={[400, 700, 900]}
										sizes="(min-width: 768px) 45vw, 100vw"
										quality={65}
										class="h-72 w-full object-cover md:h-96"
									/>
								</div>
							</div>
							<div class={index % 2 === 1 ? 'md:order-1' : ''}>
								<h2 class="font-display text-2xl text-sage-900 md:text-3xl">{item.title}</h2>
								<p class="mt-4 text-sage-700">{item.description}</p>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<section class="bg-cream-100 py-16 text-center md:py-24">
			<div class="mx-auto max-w-xl px-4 md:px-6">
				<h2 class="font-display text-2xl text-sage-900 md:text-3xl">{t('especialidadesPage.ctaTitle')}</h2>
				<p class="mt-4 text-sage-700">{t('especialidadesPage.ctaText')}</p>
				<div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
					<a
						href={getLocalizedPath('/carta', lang)}
						class="ripple rounded-full bg-sage-400 px-8 py-3 font-medium text-white shadow-sm transition-colors hover:bg-sage-500"
					>
						{t('nav.carta')}
					</a>
					<a
						href="https://www.instagram.com/gisela.pastelerianatural"
						target="_blank"
						rel="noopener noreferrer"
						class="ripple rounded-full border border-sage-300 px-8 py-3 font-medium text-sage-700 transition-colors hover:bg-sage-100"
					>
						{t('hero.ctaInstagram')}
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer lang={lang} />
</Layout>
