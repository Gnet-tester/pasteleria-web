---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import mesaDulce from '../../assets/Imágenes de ejemplo/Mesa dulce.jpg';
import { useTranslations, defaultLocale, type Locale } from '../../i18n/utils';

interface Props {
	lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

const itemIndexes = [1, 2, 3, 4] as const;
const itemIcons = [
	'<path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9Z"/>',
	'<path d="M4 21V8l8-5 8 5v13"/><path d="M9 21v-6h6v6"/>',
	'<rect x="4" y="8" width="16" height="12" rx="1.5"/><path d="M4 8l3-5h10l3 5"/><path d="M9 12h6"/>',
	'<path d="M12 3v3M12 18v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M3 12h3M18 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/><circle cx="12" cy="12" r="4"/>'
];

---

<Layout lang={lang} title={t('meta.mesasDulces.title')} description={t('meta.mesasDulces.description')}>
	<Header lang={lang} />

	<main class="bg-cream-50">
		<section class="relative overflow-hidden py-20 text-center md:py-28">
			<Image
				src={mesaDulce}
				alt=""
				class="absolute inset-0 h-full w-full object-cover"
				width={1600}
				widths={[640, 1024, 1600]}
				sizes="100vw"
				quality={55}
				loading="eager"
			/>
			<div class="absolute inset-0 bg-sage-900/75"></div>
			<div class="relative mx-auto max-w-2xl px-4 md:px-6">
				<span class="text-sm font-medium uppercase tracking-widest text-terracotta-300">
					{t('mesasDulcesPage.eyebrow')}
				</span>
				<h1 class="mt-2 font-display text-4xl text-cream-50 md:text-5xl">{t('mesasDulcesPage.title')}</h1>
				<p class="mx-auto mt-4 max-w-xl text-cream-100">{t('mesasDulcesPage.subtitle')}</p>
			</div>
		</section>

		<section class="py-16 md:py-24">
			<div class="mx-auto max-w-5xl px-4 md:px-6">
				<div class="grid gap-6 sm:grid-cols-2">
					{
						itemIndexes.map((i) => (
							<div class="flex flex-col items-center gap-3 rounded-3xl bg-white p-6 text-center shadow-sm">
								<span class="grid h-12 w-12 place-items-center rounded-full bg-terracotta-50 text-terracotta-500">
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"
										class="h-6 w-6"
										set:html={itemIcons[i - 1]}
									/>
								</span>
								<h2 class="font-display text-lg text-sage-900">
									{t(`mesasDulcesPage.item${i}.title`)}
								</h2>
								<p class="text-sm text-sage-700">{t(`mesasDulcesPage.item${i}.desc`)}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="flour-texture py-16 md:py-24">
			<div class="mx-auto max-w-5xl px-4 md:px-6">
				<div class="mx-auto max-w-2xl text-center">
					<h2 class="font-display text-2xl text-sage-900 md:text-3xl">
						{t('mesasDulcesPage.galleryTitle')}
					</h2>
					<p class="mt-3 text-sage-700">{t('mesasDulcesPage.gallerySubtitle')}</p>
				</div>

				<div class="mx-auto mt-10 max-w-3xl overflow-hidden rounded-3xl shadow-sm">
					<Image
						src={mesaDulce}
						alt={t('mesasDulcesPage.gallery.alt1')}
						width={1200}
						widths={[600, 900, 1200]}
						sizes="(min-width: 768px) 60vw, 100vw"
						quality={70}
						class="h-72 w-full object-cover sm:h-96"
					/>
				</div>
			</div>
		</section>

		<section class="bg-cream-100 py-16 text-center md:py-24">
			<div class="mx-auto max-w-xl px-4 md:px-6">
				<h2 class="font-display text-2xl text-sage-900 md:text-3xl">{t('mesasDulcesPage.ctaTitle')}</h2>
				<p class="mt-4 text-sage-700">{t('mesasDulcesPage.ctaText')}</p>
				<div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
					<a
						href="mailto:administracion@miskukis.com"
						class="ripple rounded-full bg-terracotta-400 px-8 py-3 text-center font-medium text-white shadow-sm transition-colors hover:bg-terracotta-500"
					>
						{t('mesasDulcesPage.ctaEmail')}
					</a>
					<a
						href="tel:+34987009022"
						class="ripple rounded-full border border-sage-300 px-8 py-3 text-center font-medium text-sage-700 transition-colors hover:bg-sage-100"
					>
						{t('mesasDulcesPage.ctaCall')}
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer lang={lang} />
</Layout>
