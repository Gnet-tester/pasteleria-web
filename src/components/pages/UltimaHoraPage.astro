---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import foto348 from '../../assets/Imágenes de ejemplo/foto 348.jpg';
import { useTranslations, getLocalizedPath, defaultLocale, type Locale } from '../../i18n/utils';

interface Props {
	lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

const noticias = [
	{
		fecha: 'Agosto 2026',
		titulo: 'Nueva web y ya puedes encargar tu tarta online',
		texto:
			'Estrenamos página nueva — ahora puedes ver cómo son nuestras tartas, elegir tamaño y sabor, y contarnos en persona cómo la quieres.',
		href: getLocalizedPath('/encarga-tu-tarta', lang)
	},
	{
		fecha: 'Agosto 2026',
		titulo: 'Lanzamos Gisela para empresas',
		texto:
			'Desayunos de trabajo, catering para eventos y detalles corporativos — descubre todo lo que podemos preparar para tu empresa.',
		href: getLocalizedPath('/para-empresas', lang)
	},
	{
		fecha: 'Julio 2026',
		titulo: 'Del horno a tu casa: desayunos y cestas a domicilio',
		texto: 'Ahora puedes pedir un desayuno o una cesta personalizada y te la llevamos calentita hasta tu puerta.',
		href: getLocalizedPath('/del-horno-a-tu-casa', lang)
	}
];
---

<Layout lang={lang} title={t('meta.ultimaHora.title')} description={t('meta.ultimaHora.description')}>
	<Header lang={lang} />

	<main class="bg-cream-50">
		<section class="relative overflow-hidden py-20 text-center md:py-28">
			<Image
				src={foto348}
				alt=""
				class="absolute inset-0 h-full w-full object-cover"
				width={1600}
				widths={[640, 1024, 1600]}
				sizes="100vw"
				quality={55}
				loading="eager"
			/>
			<div class="absolute inset-0 bg-sage-900/75"></div>
			<div class="relative mx-auto max-w-2xl px-4 md:px-6">
				<span class="text-sm font-medium uppercase tracking-widest text-terracotta-300">
					{t('ultimaHoraPage.eyebrow')}
				</span>
				<h1 class="mt-2 font-display text-4xl text-cream-50 md:text-5xl">{t('ultimaHoraPage.title')}</h1>
				<p class="mx-auto mt-4 max-w-xl text-cream-100">{t('ultimaHoraPage.subtitle')}</p>
			</div>
		</section>

		<section class="py-16 md:py-24">
			<div class="mx-auto flex max-w-3xl flex-col gap-6 px-4 md:px-6">
				{
					noticias.map((noticia) => (
						<a
							href={noticia.href}
							class="block rounded-3xl border border-sage-100 bg-white p-6 transition-shadow hover:shadow-lg md:p-8"
						>
							<span class="text-xs font-semibold uppercase tracking-widest text-terracotta-500">
								{noticia.fecha}
							</span>
							<h2 class="mt-2 font-display text-xl text-sage-900 md:text-2xl">{noticia.titulo}</h2>
							<p class="mt-2 text-sage-700">{noticia.texto}</p>
						</a>
					))
				}
			</div>

			<p class="mt-10 text-center text-sm text-sage-600">{t('ultimaHoraPage.footerNote')}</p>
		</section>
	</main>

	<Footer lang={lang} />
</Layout>
