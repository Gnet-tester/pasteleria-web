---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
	date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.date.toISOString(),
	inLanguage: 'es',
	mainEntityOfPage: new URL(`/blog/${post.id}`, Astro.site).toString(),
	author: { '@id': new URL('#business', Astro.site).toString() },
	publisher: { '@id': new URL('#business', Astro.site).toString() }
};
---

<Layout lang="es" title={`${post.data.title} | Gisela Pastelería Natural`} description={post.data.description}>
	<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline slot="head" />
	<Header lang="es" />

	<main class="bg-cream-50">
		<article class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-16">
			<a href="/blog" class="text-sm font-medium text-sage-600 transition-colors hover:text-sage-800">
				← Volver al blog
			</a>

			<header class="mt-6">
				<span class="text-xs font-medium uppercase tracking-widest text-terracotta-400">
					{formatDate(post.data.date)}
				</span>
				<h1 class="mt-2 font-display text-3xl leading-tight text-sage-900 md:text-4xl">
					{post.data.title}
				</h1>
				<p class="mt-4 text-lg text-sage-700">{post.data.description}</p>
			</header>

			{
				post.data.image && (
					<div class="mt-8 overflow-hidden rounded-3xl shadow-sm">
						<Image
							src={post.data.image}
							alt={post.data.imageAlt ?? ''}
							width={1000}
							widths={[500, 750, 1000]}
							sizes="(min-width: 768px) 48rem, 100vw"
							quality={70}
							class="h-72 w-full object-cover object-[center_30%] sm:h-96"
						/>
					</div>
				)
			}

			<div class="post-body mt-10">
				<Content />
			</div>

			<div class="mt-12 rounded-3xl bg-cream-100 p-8 text-center">
				<h2 class="font-display text-xl text-sage-900">¿Te ayudamos con tu encargo?</h2>
				<p class="mt-3 text-sage-700">
					Pásate por la pastelería o llámanos y lo vemos juntos.
				</p>
				<div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
					<a
						href="tel:+34987009022"
						class="ripple rounded-full bg-terracotta-400 px-8 py-3 text-center font-medium text-white shadow-sm transition-colors hover:bg-terracotta-500"
					>
						Llamar ahora
					</a>
					<a
						href="/carta"
						class="ripple rounded-full border border-sage-300 px-8 py-3 text-center font-medium text-sage-700 transition-colors hover:bg-sage-100"
					>
						Ver la carta
					</a>
				</div>
			</div>
		</article>
	</main>

	<Footer lang="es" />
</Layout>

<style is:global>
	.post-body {
		color: var(--color-sage-800);
		line-height: 1.75;
	}

	.post-body h2 {
		font-family: var(--font-display);
		font-size: 1.5rem;
		color: var(--color-sage-900);
		margin: 2.5rem 0 0.75rem;
	}

	.post-body h3 {
		font-family: var(--font-display);
		font-size: 1.2rem;
		color: var(--color-sage-900);
		margin: 2rem 0 0.5rem;
	}

	.post-body p {
		margin: 0 0 1.1rem;
	}

	.post-body ul,
	.post-body ol {
		margin: 0 0 1.4rem;
		padding-left: 1.3rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.post-body li {
		padding-left: 0.2rem;
	}

	.post-body ul li {
		list-style: disc;
	}

	.post-body ol li {
		list-style: decimal;
	}

	.post-body strong {
		color: var(--color-sage-900);
		font-weight: 600;
	}

	.post-body a {
		color: var(--color-terracotta-500);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.post-body a:hover {
		color: var(--color-terracotta-600);
	}
</style>
