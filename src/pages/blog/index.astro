---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (date: Date) =>
	date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
	lang="es"
	title="Blog | Gisela Pastelería Natural"
	description="Consejos, ideas y novedades de Gisela Pastelería Natural: tartas, desayunos, celebraciones y repostería artesanal en Ponferrada."
>
	<Header lang="es" />

	<main class="bg-cream-50">
		<section class="mx-auto max-w-4xl px-4 py-16 text-center md:px-6 md:py-20">
			<h1 class="font-display text-4xl text-sage-900 md:text-5xl">Blog</h1>
			<p class="mx-auto mt-4 max-w-2xl text-sage-700">
				Ideas, consejos y novedades de la pastelería — para que aciertes con tu tarta, tu desayuno o
				tu celebración.
			</p>
		</section>

		<section class="pb-16 md:pb-24">
			<div class="mx-auto flex max-w-4xl flex-col gap-6 px-4 md:px-6">
				{
					posts.length === 0 ? (
						<p class="text-center text-sage-700">Muy pronto publicaremos aquí nuestros primeros artículos.</p>
					) : (
						posts.map((post) => (
							<a
								href={`/blog/${post.id}`}
								class="group flex flex-col gap-4 overflow-hidden rounded-3xl border border-sage-100 bg-white transition-shadow hover:shadow-lg sm:flex-row"
							>
								{post.data.image && (
									<div class="sm:w-64 sm:shrink-0">
										<Image
											src={post.data.image}
											alt={post.data.imageAlt ?? ''}
											width={640}
											widths={[320, 480, 640]}
											sizes="(min-width: 640px) 16rem, 100vw"
											quality={68}
											class="h-48 w-full object-cover sm:h-full"
										/>
									</div>
								)}
								<div class="flex flex-col justify-center gap-2 p-6">
									<span class="text-xs font-medium uppercase tracking-widest text-terracotta-400">
										{formatDate(post.data.date)}
									</span>
									<h2 class="font-display text-xl text-sage-900 md:text-2xl">{post.data.title}</h2>
									<p class="text-sm text-sage-700">{post.data.description}</p>
								</div>
							</a>
						))
					)
				}
			</div>
		</section>
	</main>

	<Footer lang="es" />
</Layout>
