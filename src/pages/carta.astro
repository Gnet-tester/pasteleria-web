---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { menu } from '../data/menu';

const formatPrice = (price: number) =>
	price.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '€';
---

<Layout
	title="Carta | Gisela Pastelería Natural"
	description="Consulta la carta de Gisela Pastelería Natural: tartas, dulces, desayunos y bebidas elaborados a diario en nuestro obrador de Ponferrada."
>
	<Header />

	<main class="bg-cream-100">
		<div class="mx-auto max-w-4xl px-4 py-12 text-center md:px-6 md:py-16">
			<h1 class="font-display text-4xl text-sage-900 md:text-5xl">Nuestra carta</h1>
			<p class="mx-auto mt-4 max-w-2xl text-sage-700">
				Todo lo que ves, hueles y saboreas aquí —dulce y salado— lo elaboramos en nuestro propio
				obrador, con ingredientes honestos y, siempre que podemos, de kilómetro cero. Consulta a
				nuestro personal para información sobre alérgenos.
			</p>
		</div>

		<nav class="sticky top-[65px] z-40 border-y border-sage-100 bg-cream-50/95 backdrop-blur">
			<ul class="mx-auto flex max-w-4xl gap-2 overflow-x-auto px-4 py-3 md:px-6">
				{
					menu.map((group) => (
						<li>
							<a
								href={`#${group.name.toLowerCase()}`}
								class="block whitespace-nowrap rounded-full border border-sage-200 px-4 py-1.5 text-sm font-medium text-sage-700 transition-colors hover:bg-sage-100"
							>
								{group.name}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="mx-auto max-w-4xl px-4 py-12 md:px-6 md:py-16">
			{
				menu.map((group) => (
					<section id={group.name.toLowerCase()} class="scroll-mt-32 pb-14 last:pb-0">
						<h2 class="font-display text-2xl text-sage-900 md:text-3xl">{group.name}</h2>

						<div class="mt-8 grid gap-8 md:grid-cols-2">
							{group.categories.map((category) => (
								<div class="rounded-2xl border border-sage-100 bg-white p-6">
									<h3 class="font-display text-lg text-terracotta-500">
										{category.name}
										{category.note && (
											<span class="ml-2 text-sm font-normal text-sage-500">({category.note})</span>
										)}
									</h3>
									<ul class="mt-4 flex flex-col gap-2.5">
										{category.items.map((item) => (
											<li class="flex items-baseline gap-2 text-sm text-sage-700">
												<span>{item.name}</span>
												<span class="flex-1 border-b border-dotted border-sage-300" />
												<span class="font-medium text-sage-900">{formatPrice(item.price)}</span>
											</li>
										))}
									</ul>
								</div>
							))}
						</div>
					</section>
				))
			}
		</div>
	</main>

	<Footer />
</Layout>
